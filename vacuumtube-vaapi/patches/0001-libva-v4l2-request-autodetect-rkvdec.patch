 #include <sys/ioctl.h>
 
+#include <linux/media.h>
 #include <linux/videodev2.h>
 
+/*
+ * The mainline rkvdec video node is always named "rkvdec" in QUERYCAP,
+ * and its media device carries the same model name.  Discover both so
+ * the driver works without hard-coded device numbers (which change when
+ * other V4L2 devices probe first) and inside the Flatpak sandbox.
+ *
+ * Explicit LIBVA_V4L2_REQUEST_VIDEO_PATH / _MEDIA_PATH values always win.
+ */
+static const char *find_rkvdec_video(char *path, size_t path_len)
+{
+	struct v4l2_capability capability;
+	int fd, i;
+
+	for (i = 0; i < 64; i++) {
+		snprintf(path, path_len, "/dev/video%d", i);
+
+		fd = open(path, O_RDWR | O_NONBLOCK);
+		if (fd < 0)
+			continue;
+
+		memset(&capability, 0, sizeof(capability));
+		if (ioctl(fd, VIDIOC_QUERYCAP, &capability) == 0 &&
+		    (strstr((char *)capability.driver, "rkvdec") != NULL ||
+		     strstr((char *)capability.card, "rkvdec") != NULL)) {
+			close(fd);
+			return path;
+		}
+
+		close(fd);
+	}
+
+	return NULL;
+}
+
+static const char *find_rkvdec_media(char *path, size_t path_len)
+{
+	struct media_device_info info;
+	int fd, i;
+
+	for (i = 0; i < 64; i++) {
+		snprintf(path, path_len, "/dev/media%d", i);
+
+		fd = open(path, O_RDWR | O_NONBLOCK);
+		if (fd < 0)
+			continue;
+
+		memset(&info, 0, sizeof(info));
+		if (ioctl(fd, MEDIA_IOC_DEVICE_INFO, &info) == 0 &&
+		    (strstr((char *)info.driver, "rkvdec") != NULL ||
+		     strstr((char *)info.model, "rkvdec") != NULL ||
+		     strstr((char *)info.driver, "rockchip") != NULL)) {
+			close(fd);
+			return path;
+		}
+
+		close(fd);
+	}
+
+	return NULL;
+}
+
