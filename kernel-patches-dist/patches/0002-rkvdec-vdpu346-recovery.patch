+static int vdpu346_reset(struct rkvdec_core *core)
+{
+	u32 control;
+	int ret;
+
+	control = readl(core->regs + VDPU381_REG_IMPORTANT_EN);
+	writel(control | VDPU381_DEC_IRQ_DISABLE,
+	       core->regs + VDPU381_REG_IMPORTANT_EN);
+
+	ret = reset_control_bulk_assert(5, core->resets);
+	if (ret)
+		return ret;
+	udelay(5);
+	return reset_control_bulk_deassert(5, core->resets);
+}
