+/* Called with job_lock held by the IRQ thread or the watchdog, never both. */
+static void vdpu346_finish(struct rkvdec_ctx *ctx, enum vb2_buffer_state state)
+{
+	struct rkvdec_core *core = ctx->core;
+	int ret = 0;
