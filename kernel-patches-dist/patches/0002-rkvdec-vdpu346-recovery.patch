+	lockdep_assert_held(&core->job_lock);
+	if (state == VB2_BUF_STATE_ERROR)
+		ret = vdpu346_reset(core);
+	if (ret) {
+		core->failed = true;
+		dev_err(core->dev, "Decoder reset failed (%d); disabling core\n", ret);
+	}
+
+	/* Reset-ready or a queued old IRQ must not leak into the next job. */
+	writel(readl(core->regs + VDPU381_REG_IMPORTANT_EN) |
+	       VDPU381_DEC_IRQ_DISABLE, core->regs + VDPU381_REG_IMPORTANT_EN);
+	writel(0, core->regs + VDPU381_REG_STA_INT);
+	readl(core->regs + VDPU381_REG_STA_INT);
+	core->job_active = false;
+	rkvdec_job_finish(ctx, state);
