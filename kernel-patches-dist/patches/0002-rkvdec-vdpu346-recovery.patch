diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu346-test.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu346-test.c
new file mode 100644
index 000000000..b309f00c8
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu346-test.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "rkvdec-vdpu346.h"
+
+static void vdpu346_completion_test(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x01));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x02));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x04));
+	KUNIT_EXPECT_TRUE(test, vdpu346_decode_succeeded(0x06));
+	KUNIT_EXPECT_TRUE(test, vdpu346_decode_succeeded(0x07));
+}
+
+static void vdpu346_error_precedence_test(struct kunit *test)
+{
+	unsigned int bit;
+
+	/* Bus, decode, timeout, empty-buffer and ColMV errors override ready. */
+	for (bit = 3; bit <= 7; bit++)
+		KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x07 | BIT(bit)));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x207));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x3ff));
+	/* The real-content timeout, both without and with ready also asserted. */
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x23));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x27));
+}
+
+static void vdpu346_nonfatal_status_test(struct kunit *test)
+{
+	/* CABAC end does not independently indicate decode failure. */
+	KUNIT_EXPECT_TRUE(test, vdpu346_decode_succeeded(0x107));
+	KUNIT_EXPECT_FALSE(test, vdpu346_decode_succeeded(0x103));
+}
+
+static struct kunit_case vdpu346_cases[] = {
+	KUNIT_CASE(vdpu346_completion_test),
+	KUNIT_CASE(vdpu346_error_precedence_test),
+	KUNIT_CASE(vdpu346_nonfatal_status_test),
+	{}
+};
+
+static struct kunit_suite vdpu346_suite = {
+	.name = "rkvdec-vdpu346",
+	.test_cases = vdpu346_cases,
+};
+
+kunit_test_suite(vdpu346_suite);
+
+MODULE_LICENSE("GPL");
