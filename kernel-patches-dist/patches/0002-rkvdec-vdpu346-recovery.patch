@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef RKVDEC_VDPU346_H_
+#define RKVDEC_VDPU346_H_
+
+#include <linux/bits.h>
+#include <linux/types.h>
+
+#define VDPU346_IRQ_RAW		BIT(1)
+#define VDPU346_DECODE_READY	BIT(2)
+#define VDPU346_DECODE_ERRORS	(GENMASK(7, 3) | BIT(9))
+
+static inline bool vdpu346_decode_succeeded(u32 status)
+{
+	return (status & VDPU346_IRQ_RAW) && (status & VDPU346_DECODE_READY) &&
+	       !(status & VDPU346_DECODE_ERRORS);
+}
+
+#endif /* RKVDEC_VDPU346_H_ */
