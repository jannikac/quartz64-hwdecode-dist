[Unit]
Description=Clear initramfs USB-network address from real Ethernet
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if /usr/sbin/ip -4 addr show dev eth0 | grep -q 172.16.42.1; then /usr/sbin/ip addr flush dev eth0; /usr/bin/nmcli device set eth0 managed yes; /usr/bin/nmcli connection up "Wired connection 1" || true; fi'

[Install]
WantedBy=multi-user.target
